---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts: CollectionEntry<"blog">[] = await getCollection("blog");
const sortedPosts = posts.sort(
  (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime(),
);
const featuredPosts = sortedPosts.filter((post) => post.data.featured);
const listedPosts = featuredPosts.length > 0 ? featuredPosts : sortedPosts;
const siteUrl = Astro.site ?? new URL("https://filegrc.com");
const pageTitle = "filegrc Blog | Practical SOC 2 Guides for Engineers";
const pageDescription =
  "Plain guides for founders and engineers running SOC 2 programs, collecting evidence, preparing audits, and managing compliance work in Git.";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "filegrc Blog",
  description: pageDescription,
  url: new URL("/blog", siteUrl).href,
  publisher: {
    "@type": "Organization",
    name: "filegrc",
    url: siteUrl.href,
  },
  blogPost: listedPosts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    url: new URL(`/blogs/${post.id}`, siteUrl).href,
    datePublished: post.data.publishedDate.toISOString(),
    author: {
      "@type": "Person",
      name: post.data.author,
    },
  })),
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={structuredData}
>
  <section class="blog-index-hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="shell">
      <span class="eyebrow eyebrow--light">Field notes</span>
      <h1>filegrc Blog</h1>
      <p>
        Practical answers for founders and engineers doing SOC 2 work without
        turning the program into another closed SaaS database.
      </p>
    </div>
  </section>

  <section class="blog-index">
    <div class="shell">
      {
        listedPosts.length > 0 ? (
          <div class="blog-grid">
            {listedPosts.map((post) => {
              const formattedDate = post.data.publishedDate.toLocaleDateString(
                "en-US",
                {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                  timeZone: "UTC",
                },
              );

              return (
                <article class="blog-card">
                  <a href={`/blogs/${post.id}`}>
                    {post.data.featured && (
                      <span class="blog-card__featured">Featured</span>
                    )}
                    <h2>{post.data.title}</h2>
                    <div class="blog-card__meta">
                      <span>{post.data.author}</span>
                      <time datetime={post.data.publishedDate.toISOString()}>
                        {formattedDate}
                      </time>
                    </div>
                    <p>{post.data.description}</p>
                    <div class="blog-tags">
                      {post.data.tags.map((tag: string) => (
                        <span>{tag}</span>
                      ))}
                    </div>
                    <strong>Read more →</strong>
                  </a>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="blog-empty">
            <span class="eyebrow">Articles coming soon</span>
            <h2>We are writing the guides we wanted when starting SOC 2.</h2>
            <p>
              Until then, the filegrc repository explains the full program path
              and gives you a working local workspace.
            </p>
            <a
              class="button blog-empty__button"
              href="https://github.com/Alignbase/filegrc"
            >
              Read the filegrc README
            </a>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
