    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-github-btn": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.19"
  }
