{
  "name": "filegrc-site",
  "version": "0.13.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "sites:prepare": "node scripts/prepare-sites.mjs",
    "preview": "astro preview",
    "typecheck": "astro check",
    "format": "prettier --write \"**/*.{astro,css,js,json,md,mdx,mjs,ts}\"",
