{
  "name": "filegrc-monorepo",
  "version": "0.6.4",
  "private": true,
  "workspaces": [
    "packages/filegrc",
    "packages/create-filegrc",
    "site"
  ],
  "scripts": {
    "dev": "node --watch scripts/dev.mjs",
    "site:dev": "npm run dev --workspace filegrc-site",
    "site:build": "npm run build --workspace filegrc-site",
    "site:validate": "npm run validate --workspace filegrc-site",
    "test": "npm test --workspaces --if-present",
    "validate": "npm test --workspaces --if-present && node packages/filegrc/bin/filegrc.js model --check-docs && node scripts/check-readme-assets.mjs && npm run validate --workspace filegrc-site"
  },
  "engines": {
    "node": ">=20"
  }
}
